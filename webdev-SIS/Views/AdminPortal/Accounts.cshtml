@model List<UserEntity>


@{
    Layout = "Admin_Layout";
    ViewData["Title"] = "Accounts";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <!-- Background Image -->
    <img src="~/images/bgjr.png"
         alt="Decorative background representing Grade 7"
         class="img-fluid w-100"
         style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">

    <!-- Main Content -->
    <div class="container-fluid" style="background-color: rgba(220, 232, 253, 0.9); padding: 20px; border-radius: 10px;">

        <section class="px-3 py-6" style="font-weight: bold;">
            <div class="d-flex justify-content-between align-items-center">
                <!-- Icon and Link -->
                <p class="text-sm text-black fs-5 mb-0">
                    <i class="fas fa-user"></i>
                    <a asp-controller="AdminPortal" asp-action="Accounts" class="text-black ms-2" style="text-decoration: none;">Admin Accounts</a>
                </p>

                <!-- Add Account Button -->
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#adminModal" id="addBtn">
                    <i class="fas fa-plus-circle"></i> Add Admin Accounts
                </button>
            </div>
        </section>



        <!-- Account Table -->
        <div class="table-responsive mt-3">
            <table class="table">
                <thead>
                    <tr>
                        <th style="background-color: #162051; color: white; border-radius: 10px 0 0 0; text-align: center;">Admin Name</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Email</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Role</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Date created</th>
                        <th style="background-color: #162051; color: white; border-radius: 0 10px 0 0; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.Any() == true)
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="text-center" id="accountRow-@item.Id">
                                <td>@item.FirstName @item.LastName</td>
                                <td>@item.Email</td>
                                <td>@item.Role</td>                                  
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm" type="button"
                                            data-bs-toggle="modal" data-bs-target="#deleteaccountModal"
                                            onclick="setDeleteAccountId(@item.Id, 'account')">
                                        <i class="fas fa-user-minus"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No faculty members available</td>
                        </tr>
                    }


                </tbody>
            </table>
        </div>

        <!-- Delete Account Modal -->
        <div class="modal fade" id="deleteaccountModal" tabindex="-1" aria-labelledby="deleteaccountModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Confirm Deletion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="deleteAccountForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteAccountId" />
                        <div class="modal-body">
                            <p>Are you sure you want to delete this account?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-user-minus"></i> Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>




    </div>




    <!-- Add Accounts Modal -->
    <div class="modal fade" id="adminModal" tabindex="-1" aria-labelledby="adminModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="adminModalLabel">Admin Sign Up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="Admin" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <!-- First Name and Last Name -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="FirstName" class="form-label">First Name</label>
                                <input type="text" class="form-control" id="FirstName" name="FirstName" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="LastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="LastName" name="LastName" required />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="Email" name="Email" required onblur="validateEmail()" />
                                <small id="emailError" style="color: red; display: none;">Please enter a valid email address.</small>
                            </div>

                            <!-- Role -->
                            <div class="col-md-6 mb-3">
                                <label for="RoleDisplay" class="form-label">Role</label>
                                <input type="text" class="form-control" id="RoleDisplay" value="Admin" disabled />
                                <input type="hidden" name="Role" value="Admin" />
                            </div>                 
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="Password" class="form-label">Password</label>
                            <div class="input-group">
                                <input type="password"
                                       class="form-control"
                                       id="Password"
                                       name="PasswordHash"
                                       required
                                       pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{12,}$"
                                       title="Password must be at least 12 characters and include uppercase, lowercase, number, and symbol." />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <span>
                                        <i class="fa fa-eye-slash" id="eye-icon"></i>
                                    </span>
                                </button>
                            </div>
                            <div id="password-checklist" class="mt-2 text-sm">
                                <small class="d-block text-muted"><strong>Password must contain:</strong></small>
                                <ul class="list-unstyled ps-3">
                                    <li id="lengthCheck" class="text-danger">✔ At least 12 characters</li>
                                    <li id="lowerCheck" class="text-danger">✔ Lowercase letter</li>
                                    <li id="upperCheck" class="text-danger">✔ Uppercase letter</li>
                                    <li id="numberCheck" class="text-danger">✔ Number</li>
                                    <li id="symbolCheck" class="text-danger">✔ Symbol)</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" id="createAccountBtn" class="btn btn-primary" disabled>Create Admin Account</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>



    <!-- Encode Grade Status Modal -->
    <div class="modal fade" id="encodeGradeStatusModal" tabindex="-1" aria-labelledby="encodeGradeStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="encodeGradeStatusModalLabel">Encode Grade Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <!-- Modal Body -->
                <div class="modal-body">
                    <form id="encodeGradeStatusForm">
                        <!-- Grading Periods -->
                        <div class="mb-3">
                            <label for="gradingPeriod" class="form-label">Select Grading Period</label>
                            <select class="form-select" id="gradingPeriod">
                                <option value="1st Grading">1st Grading</option>
                                <option value="2nd Grading">2nd Grading</option>
                                <option value="3rd Grading">3rd Grading</option>
                                <option value="4th Grading">4th Grading</option>
                            </select>
                        </div>
                        <!-- Current Status -->
                        <div class="mb-3">
                            <label for="currentStatus" class="form-label">Current Status</label>
                            <input type="text" class="form-control" id="currentStatus" value="Closed" readonly>
                        </div>
                        <!-- Update Status -->
                        <div class="mb-3">
                            <label for="newStatus" class="form-label">New Status</label>
                            <select class="form-select" id="newStatus">
                                <option value="Open">Open</option>
                                <option value="Closed" selected>Closed</option>
                            </select>
                        </div>
                    </form>
                </div>
                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="updateGradeStatus()">Save Changes</button>
                </div>
            </div>
        </div>
    </div>

    <script>
            
        //restrcitions
        const passwordInput = document.getElementById('Password');
        const togglePassword = document.getElementById('togglePassword');
        const eyeIcon = document.getElementById('eye-icon');

        const lengthCheck = document.getElementById('lengthCheck');
        const lowerCheck = document.getElementById('lowerCheck');
        const upperCheck = document.getElementById('upperCheck');
        const numberCheck = document.getElementById('numberCheck');
        const symbolCheck = document.getElementById('symbolCheck');

        passwordInput.addEventListener('input', function () {
            const password = passwordInput.value;

            lengthCheck.classList.toggle('text-success', password.length >= 12);
            lengthCheck.classList.toggle('text-danger', password.length < 12);

            lowerCheck.classList.toggle('text-success', /[a-z]/.test(password));
            lowerCheck.classList.toggle('text-danger', !/[a-z]/.test(password));

            upperCheck.classList.toggle('text-success', /[A-Z]/.test(password));
            upperCheck.classList.toggle('text-danger', !/[A-Z]/.test(password));

            numberCheck.classList.toggle('text-success', /\d/.test(password));
            numberCheck.classList.toggle('text-danger', !/\d/.test(password));

            symbolCheck.classList.toggle('text-success', /[^A-Za-z0-9]/.test(password));
            symbolCheck.classList.toggle('text-danger', !/[^A-Za-z0-9]/.test(password));
        });


             togglePassword.addEventListener('click', function () {
            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            eyeIcon.classList.toggle('fa-eye');
            eyeIcon.classList.toggle('fa-eye-slash');
        });

        const createAccountBtn = document.getElementById('createAccountBtn');

        function validatePasswordChecklist() {
            const isValid =
                passwordInput.value.length >= 12 &&
                /[a-z]/.test(passwordInput.value) &&
                /[A-Z]/.test(passwordInput.value) &&
                /\d/.test(passwordInput.value) &&
                /[^A-Za-z0-9]/.test(passwordInput.value);

            createAccountBtn.disabled = !isValid;
        }

        // Call it every time the password changes
        passwordInput.addEventListener('input', validatePasswordChecklist);

        //email
                //gmail
                      var domain = '@@gmail.com';  // Razor now correctly treats this as a string and not as C# code

                    function validateEmail() {
                      var email = document.getElementById('Email').value;
                      var emailError = document.getElementById('emailError');

                      // Check if the email ends with @@gmail.com
                      if (!email.endsWith(domain)) {
                        emailError.style.display = 'block';  // Show error message
                      } else {
                        emailError.style.display = 'none';  // Hide error message
                      }
                    }




        //delete

                let deleteContext = "faculty"; // default fallback

        function setDeleteAccountId(id, context) {
            document.getElementById('deleteAccountId').value = id;
            deleteContext = context;
        }

                document.getElementById("deleteAccountForm").addEventListener("submit", function (e) {
            e.preventDefault();

            const id = document.getElementById("deleteAccountId").value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("/AdminPortal/DeleteAccount", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: `id=${id}&__RequestVerificationToken=${token}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close the modal
                    const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteaccountModal'));
                    if (deleteModal) deleteModal.hide();

                    // Show success message with reload option
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: data.message,
                        showConfirmButton: true,
                        confirmButtonText: 'Reload Page',
                        timer: 2000,
                        timerProgressBar: true,
                        willClose: () => {
                            // Reload the page when the alert closes
                            window.location.reload();
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'Failed to delete account'
                    });
                }
            })
            .catch(error => {
                console.error('Delete error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred.'
                });
            });
        });

</script>
   
</body>

