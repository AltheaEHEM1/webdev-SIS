@model IEnumerable<EnrollmentEntity>

@{
    Layout = "Admin_Layout";
    ViewData["Title"] = "Enrollment Details";
}

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <img src="~/images/bgjr.png" alt="Decorative background" class="img-fluid w-100"
         style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">

    <div style="background-color: rgba(220, 232, 253, 0.9); padding: 20px; border-radius: 10px;">
        <section class="fixed ml-72 px-11 py-6 w-full top-20 left-0" style="font-weight: bold;">
            <p class="text-sm text-black fs-5">
                <i class="fas fa-user text-black"></i>
                <a asp-controller="AdminPortal" asp-action="EnrollmentDetails" class="text-black" style="text-decoration: none;">Review Application</a>
            </p>
        </section>

        <div class="container mt-2">
            @if (Model != null && Model.Any())
            {
                @foreach (var enrollment in Model) // ✅ Loop through the list
                {
                    <div class="container">
                        <div class="row">
                            <!-- Left Column -->
                            <div class="col-md-6">
                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">
                                        Incoming
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Grade Level:</strong></div>
                                            <div class="col-8">@enrollment.GradeLevel</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">
                                        Personal Information
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Full Name:</strong></div>
                                            <div class="col-8">@($"{enrollment.FirstName} {enrollment.MiddleName} {enrollment.LastName} {enrollment.Suffix}")</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Email:</strong></div>
                                            <div class="col-8">@enrollment.Email</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Date of Birth:</strong></div>
                                            <div class="col-8">@enrollment.DateOfBirth.ToShortDateString()</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-4"><strong>Civil Status:</strong></div>
                                            <div class="col-md-8">@enrollment.CivilStatus</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Sex:</strong></div>
                                            <div class="col-md-8">@enrollment.Sex</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Country:</strong></div>
                                            <div class="col-md-8">@enrollment.Country</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Region:</strong></div>
                                            <div class="col-md-8">@enrollment.Region</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>City / Municipality:</strong></div>
                                            <div class="col-md-8">@enrollment.City</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Height:</strong>Height:</div>
                                            <div class="col-md-8">@enrollment.Height</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Weight:</strong></div>
                                            <div class="col-md-8">@enrollment.Weight</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Religion:</strong></div>
                                            <div class="col-md-8">@enrollment.Religion</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Disability:</strong></div>
                                            <div class="col-md-8">@enrollment.Disability</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">
                                        Contact
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Landline:</strong></div>
                                            <div class="col-md-8">@enrollment.Landline_number</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Phone:</strong></div>
                                            <div class="col-8">@enrollment.Phone_number</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-4 fw-bold">Emergency Contact:</div>
                                            <div class="col-md-8">@enrollment.ContactPerson - @enrollment.ContactNumber (@enrollment.Relationship)</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-4 fw-bold"> <strong>Emergency Landline:</strong></div>
                                            <div class="col-md-8">@enrollment.Emergency_landline_number</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-md-6">
                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">
                                        Address
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Current:</strong></div>
                                            <div class="col-8">@($"{enrollment.HouseNo}, {enrollment.Street}, {enrollment.Barangay}, {enrollment.Municipality}, {enrollment.Province}, {enrollment.ZipCode}")</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Permanent:</strong></div>
                                            <div class="col-8">@($"{enrollment.PermanentHouseNo}, {enrollment.PermanentStreet}, {enrollment.PermanentBarangay}, {enrollment.PermanentMunicipality}, {enrollment.PermanentProvince}, {enrollment.PermanentZipCode}")</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">
                                        Family
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Parent:</strong></div>
                                            <div class="col-8">@($"{enrollment.ParentFirstName} {enrollment.ParentMiddleName} {enrollment.ParentLastName} - {enrollment.ParentContactNo} ({enrollment.ParentRelationship})")</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Guardian:</strong></div>
                                            <div class="col-8">@($"{enrollment.GuardianFirstName} {enrollment.GuardianMiddleName} {enrollment.GuardianLastName} {enrollment.GuardianContactNo} ({enrollment.GuardianRelationship})")</div>
                                        </div>
                                    </div>
                                </div>


                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">School</div>
                                    <div class="card-body p-3">
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Name:</div><div class="col-md-8">@enrollment.SchoolName</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Address:</div><div class="col-md-8">@enrollment.SchoolAddress</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Contact:</div><div class="col-md-8">@enrollment.SchoolContact</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Type:</div><div class="col-md-8">@enrollment.SchoolType</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">Year Of Graduation:</div><div class="col-md-8">@enrollment.YearOfGraduation</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">LRN:</div><div class="col-md-8">@enrollment.LRN</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">GWA:</div><div class="col-md-8">@enrollment.GWA</div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary"
                                onclick="openModal('@($"{enrollment.FirstName} {enrollment.MiddleName} {enrollment.LastName}")', '@enrollment.GradeLevel', '@enrollment.Id')">
                            Enroll Student
                        </button>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted">No admissions found.</p>
            }
        </div>
    </div>


    <!-- Modal for selecting section -->
    <div class="modal fade" id="sectionModal" tabindex="-1" aria-labelledby="sectionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header text-white" style="background-color: #162051;">
                    <h5 class="modal-title" id="sectionModalLabel">Select Section</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Student Name:</strong> <span id="studentName"></span></p>
                    <p><strong>Grade Level:</strong> <span id="studentGradeLevel"></span></p>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th style="background-color: #162051; color: white; padding: 10px 30px;">Section Name</th>
                            </tr>
                        </thead>
                        <tbody id="sectionList">
                            <!-- Sections will be dynamically injected here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <!-- Place this at the bottom, inside your <script> tag -->
    <script>
        let selectedStudentId = null;

        function openModal(studentName, gradeLevel, studentId) {
            document.getElementById("studentName").innerText = studentName;
            document.getElementById("studentGradeLevel").innerText = gradeLevel;
            selectedStudentId = studentId; // Store the student ID globally


                 // Change background color based on grade level
        const sectionHeader = document.querySelector("#sectionList").previousElementSibling.querySelector("th");
        let bgColor = "#162051"; // default

        switch (gradeLevel.toLowerCase()) {
            case "grade 7":
                bgColor = "#28a745"; // green
                break;
            case "grade 8":
                bgColor = "#ffc107"; // yellow
                break;
            case "grade 9":
                bgColor = "#dc3545"; // red
                break;
            case "grade 10":
                bgColor = "#007bff"; // blue
                break;
        }

        sectionHeader.style.backgroundColor = bgColor;


            // Fetch sections based on grade level
            fetch(`/AdminPortal/GetSections?gradeLevel=${gradeLevel}`)
                .then(response => response.json())
                .then(data => {
                    const sectionListContainer = document.getElementById("sectionList");
                    sectionListContainer.innerHTML = "";

                    data.forEach(section => {
                        sectionListContainer.innerHTML += `<tr>
                            <td>
                                <button class="btn btn-link"
                                        style="text-decoration: none; color: black; width: 100%; text-align: left; padding: 10px; border-radius: 5px;"
                                        onmouseover="this.style.backgroundColor='#E6F7FF'; this.style.color='#007BFF'; this.style.fontWeight='bold'; this.style.cursor='pointer';"
                                        onmouseout="this.style.backgroundColor='transparent'; this.style.color='black'; this.style.fontWeight='normal';"
                                        onclick="selectSection('${section}')">
                                    ${section}
                                </button>
                            </td>
                        </tr>`;
                    });

                    if (data.length === 0) {
                        sectionListContainer.innerHTML = `<tr><td class="text-center text-muted">No sections available for this grade level.</td></tr>`;
                    }

                    const modal = new bootstrap.Modal(document.getElementById("sectionModal"));
                    modal.show();
                })
                .catch(error => console.error("Error fetching sections:", error));
        }

         function selectSection(section) {
            fetch('/AdminPortal/AssignSection', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Id: selectedStudentId, SectionName: section })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/AdminPortal/StudentList?section=' + data.section;
                } else {
                    alert('Error: ' + data.message);
                }
            })

            .catch(error => console.error('Error:', error));
        }

    </script>


</body>