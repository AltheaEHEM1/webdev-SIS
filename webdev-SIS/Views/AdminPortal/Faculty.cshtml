@model List<UserEntity>

@{
    Layout = "Admin_Layout";
    ViewData["Title"] = "Faculty";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <!-- Background Image -->
    <img src="~/images/bgjr.png"
         alt="Decorative background representing Grade 7"
         class="img-fluid w-100"
         style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">

    <!-- Main Content -->
    <div class="container-fluid" style="background-color: rgba(220, 232, 253, 0.9); padding: 20px; border-radius: 10px;">
        <section class="px-3 py-6" style="font-weight: bold;">
            <div class="row align-items-center">

                <!-- Icon and Link -->
                <div class="col-12 col-md-auto mb-3 mb-md-0">
                    <p class="text-sm text-black fs-5 mb-0">
                        <i class="fas fa-user text-black"></i>
                        <a asp-controller="AdminPortal" asp-action="Faculty" class="text-black ms-2" style="text-decoration: none;">Faculty</a>
                    </p>
                </div>

                <!-- Buttons -->
                <div class="col-12 col-md-auto ms-auto text-md-end">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#encodeGradeStatusModal">
                            Grade Status
                        </button>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#facultyModal" id="addBtn">
                            <i class="fas fa-plus-circle"></i> Add Faculty
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <!-- Faculty Table -->
        <div class="table-responsive mt-3">
            <table class="table">
                <thead>
                    <tr>
                        <th style="background-color: #162051; color: white; border-radius: 10px 0 0 0; text-align: center;">Faculty Name</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Email</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Role</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Position</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Subject</th>
                        <th style="background-color: #162051; color: white; border-radius: 0 10px 0 0; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.Any() == true)
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="text-center" id="facultyRow-@item.Id">
                                <td>@item.FirstName @item.LastName</td>
                                <td>@item.Email</td>
                                <td>@item.Role</td>
                                <td>@item.Position</td>                  
                                <td>@item.Subject</td>
                                <td>
                                    <!-- Update each edit button in your table rows -->
                                    <button class="btn btn-outline-warning btn-sm"
                                            onclick="loadFacultyForEdit('@item.Id')">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm" type="button"
                                            data-bs-toggle="modal" data-bs-target="#deleteaccountModal"
                                            onclick="setDeleteAccountId(@item.Id, 'faculty')">
                                        <i class="fas fa-user-minus"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">No faculty members available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Delete Account Modal -->
        <div class="modal fade" id="deleteaccountModal" tabindex="-1" aria-labelledby="deleteaccountModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Confirm Deletion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="deleteAccountForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteAccountId" />
                        <div class="modal-body">
                            <p>Are you sure you want to delete this account?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-user-minus"></i> Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>



    <!-- Add Faculty Modal -->
    <div class="modal fade" id="facultyModal" tabindex="-1" aria-labelledby="facultyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="facultyModalLabel">Faculty Sign Up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="Faculty" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <!-- First Name and Last Name Inline -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="FirstName" class="form-label">First Name</label>
                                <input type="text" class="form-control" id="FirstName" name="FirstName" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="LastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="LastName" name="LastName" required />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="Email" name="Email" required onblur="validateEmail()" />
                                <small id="emailError" style="color: red; display: none;">Please enter a valid email address.</small>
                            </div>


                            <!-- Role -->
                            <div class="col-md-6 mb-3">
                                <label for="RoleDisplay" class="form-label">Role</label>
                                <input type="text" class="form-control" id="RoleDisplay" value="Faculty" disabled />
                                <input type="hidden" name="Role" value="Faculty" />
                            </div>
                        </div>

                        <!-- Subject and Position Inline -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Subject" class="form-label">Subject</label>
                                <select class="form-select" id="Subject" name="Subject" required>
                                    <option value="Filipino">Filipino</option>
                                    <option value="English">English</option>
                                    <option value="Math">Mathematics</option>
                                    <option value="Science">Science</option>
                                    <option value="AP">Araling Panlipunan</option>
                                    <option value="EsP">Edukasyon sa Pagpapakatao</option>
                                    <option value="TLE">Technology and Livelihood Education</option>
                                    <option value="MAPEH">MAPEH</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="Position" class="form-label">Position</label>
                                <select class="form-select" id="Position" name="Position" required>
                                    <option value="Teacher I">Teacher I</option>
                                    <option value="Teacher II">Teacher II</option>
                                    <option value="Teacher III">Teacher III</option>
                                    <option value="Master Teacher I">Master Teacher I</option>
                                    <option value="Master Teacher II">Master Teacher II</option>
                                    <option value="Master Teacher III">Master Teacher III</option>
                                    <option value="Head Teacher">Head Teacher</option>
                                </select>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="col-md-6 mb-3">
                            <label for="Password" class="form-label">Password</label>
                            <div class="input-group">
                                <input type="password"
                                       class="form-control"
                                       id="Password"
                                       name="PasswordHash"
                                       required
                                       pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{12,}$"
                                       title="Password must be at least 12 characters and include uppercase, lowercase, number, and symbol." />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <span>
                                        <i class="fa fa-eye-slash" id="eye-icon"></i>
                                    </span>
                                </button>
                            </div>
                            <div id="password-checklist" class="mt-2 text-sm">
                                <small class="d-block text-muted"><strong>Password must contain:</strong></small>
                                <ul class="list-unstyled ps-3">
                                    <li id="lengthCheck" class="text-danger">✔ At least 12 characters</li>
                                    <li id="lowerCheck" class="text-danger">✔ Lowercase letter</li>
                                    <li id="upperCheck" class="text-danger">✔ Uppercase letter</li>
                                    <li id="numberCheck" class="text-danger">✔ Number</li>
                                    <li id="symbolCheck" class="text-danger">✔ Symbol)</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Submit Button aligned to the right -->
                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary">Create Faculty Account</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>




    <!-- Edit Faculty Modal -->
    <div class="modal fade" id="editaccountModal" tabindex="-1" aria-labelledby="editFacultyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="editFacultyModalLabel">Edit Faculty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form id="editFacultyForm" method="post" asp-action="UpdateFaculty">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editFacultyId" name="Id" />

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">First Name</label>
                                <input type="text" class="form-control" id="editFirstName" name="FirstName" disabled />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="editLastName" name="LastName" disabled />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" id="editEmail" name="Email" disabled />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Role</label>
                                <input type="text" class="form-control" value="Faculty" disabled />
                                <input type="hidden" name="Role" value="Faculty" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Subject</label>
                                <select class="form-select" id="editSubject" name="Subject" required>
                                    <option value="">-- Select Subject --</option>
                                    <option value="Filipino">Filipino</option>
                                    <option value="English">English</option>
                                    <option value="Math">Mathematics</option>
                                    <option value="Science">Science</option>
                                    <option value="AP">Araling Panlipunan</option>
                                    <option value="EsP">EsP</option>
                                    <option value="TLE">TLE</option>
                                    <option value="MAPEH">MAPEH</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Position</label>
                                <select class="form-select" id="editPosition" name="Position" required>
                                    <option value="">-- Select Position --</option>
                                    <option value="Teacher I">Teacher I</option>
                                    <option value="Teacher II">Teacher II</option>
                                    <option value="Teacher III">Teacher III</option>
                                    <option value="Master Teacher I">Master Teacher I</option>
                                    <option value="Master Teacher II">Master Teacher II</option>
                                    <option value="Master Teacher III">Master Teacher III</option>
                                    <option value="Head Teacher">Head Teacher</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>






   



    <!-- Encode Grade Status Modal -->
    <div class="modal fade" id="encodeGradeStatusModal" tabindex="-1" aria-labelledby="encodeGradeStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="encodeGradeStatusModalLabel">Encode Grade Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <!-- Modal Body -->
                <div class="modal-body">
                    <form id="encodeGradeStatusForm">
                        <!-- Grading Periods -->
                        <div class="mb-3">
                            <label for="gradingPeriod" class="form-label">Select Grading Period</label>
                            <select class="form-select" id="gradingPeriod">
                                <option value="1st Grading">1st Grading</option>
                                <option value="2nd Grading">2nd Grading</option>
                                <option value="3rd Grading">3rd Grading</option>
                                <option value="4th Grading">4th Grading</option>
                            </select>
                        </div>
                        <!-- Current Status -->
                        <div class="mb-3">
                            <label for="currentStatus" class="form-label">Current Status</label>
                            <input type="text" class="form-control" id="currentStatus" value="Closed" readonly>
                        </div>
                        <!-- Update Status -->
                        <div class="mb-3">
                            <label for="newStatus" class="form-label">New Status</label>
                            <select class="form-select" id="newStatus">
                                <option value="Open">Open</option>
                                <option value="Closed" selected>Closed</option>
                            </select>
                        </div>
                    </form>
                </div>
                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="updateGradeStatus()">Save Changes</button>
                </div>
            </div>
        </div>
    </div>



    <script>
     //restrictions
                const passwordInput = document.getElementById('Password');
                const togglePassword = document.getElementById('togglePassword');
                const eyeIcon = document.getElementById('eye-icon');

                const lengthCheck = document.getElementById('lengthCheck');
                const lowerCheck = document.getElementById('lowerCheck');
                const upperCheck = document.getElementById('upperCheck');
                const numberCheck = document.getElementById('numberCheck');
                const symbolCheck = document.getElementById('symbolCheck');

                passwordInput.addEventListener('input', function () {
                    const password = passwordInput.value;

                    lengthCheck.classList.toggle('text-success', password.length >= 12);
                    lengthCheck.classList.toggle('text-danger', password.length < 12);

                    lowerCheck.classList.toggle('text-success', /[a-z]/.test(password));
                    lowerCheck.classList.toggle('text-danger', !/[a-z]/.test(password));

                    upperCheck.classList.toggle('text-success', /[A-Z]/.test(password));
                    upperCheck.classList.toggle('text-danger', !/[A-Z]/.test(password));

                    numberCheck.classList.toggle('text-success', /\d/.test(password));
                    numberCheck.classList.toggle('text-danger', !/\d/.test(password));

                    symbolCheck.classList.toggle('text-success', /[^A-Za-z0-9]/.test(password));
                    symbolCheck.classList.toggle('text-danger', !/[^A-Za-z0-9]/.test(password));
                });


                     togglePassword.addEventListener('click', function () {
                    const isPassword = passwordInput.type === 'password';
                    passwordInput.type = isPassword ? 'text' : 'password';
                    eyeIcon.classList.toggle('fa-eye');
                    eyeIcon.classList.toggle('fa-eye-slash');
                });


                    const createAccountBtn = document.getElementById('createAccountBtn');

                function validatePasswordChecklist() {
                    const isValid =
                        passwordInput.value.length >= 12 &&
                        /[a-z]/.test(passwordInput.value) &&
                        /[A-Z]/.test(passwordInput.value) &&
                        /\d/.test(passwordInput.value) &&
                        /[^A-Za-z0-9]/.test(passwordInput.value);

                    createAccountBtn.disabled = !isValid;
                }

                // Call it every time the password changes
                passwordInput.addEventListener('input', validatePasswordChecklist);



                //gmail
                      var domain = '@@gmail.com';  // Razor now correctly treats this as a string and not as C# code

                    function validateEmail() {
                      var email = document.getElementById('Email').value;
                      var emailError = document.getElementById('emailError');

                      // Check if the email ends with @@gmail.com
                      if (!email.endsWith(domain)) {
                        emailError.style.display = 'block';  // Show error message
                      } else {
                        emailError.style.display = 'none';  // Hide error message
                      }
                    }

            //delete
                 let deleteContext = "faculty"; // default fallback

        function setDeleteAccountId(id, context) {
            document.getElementById('deleteAccountId').value = id;
            deleteContext = context;
        }

               document.getElementById("deleteAccountForm").addEventListener("submit", function (e) {
            e.preventDefault();

            const id = document.getElementById("deleteAccountId").value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("/AdminPortal/DeleteAccount", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: `id=${id}&__RequestVerificationToken=${token}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close the modal
                    const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteaccountModal'));
                    if (deleteModal) deleteModal.hide();

                    // Show success message with reload option
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: data.message,
                        showConfirmButton: true,
                        confirmButtonText: 'Reload Page',
                        timer: 2000,
                        timerProgressBar: true,
                        willClose: () => {
                            // Reload the page when the alert closes
                            window.location.reload();
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'Failed to delete account'
                    });
                }
            })
            .catch(error => {
                console.error('Delete error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred.'
                });
            });
        });






        /////////EDIT
                     // Improved edit faculty functionality
        function loadFacultyForEdit(id) {
            // Show loading indicator or message
            console.log("Loading faculty data for ID:", id);

               fetch(`/AdminPortal/sp_SelectUserById?id=${id}`, {
                method: "GET",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`Network response was not ok: ${response.status} ${response.statusText}`);
                }
                return response.json();
            })
            .then(data => {
                console.log("Faculty data received:", data);

                // Fill the modal form with the received data
                document.getElementById('editFacultyId').value = data.id;
                document.getElementById('editFirstName').value = data.firstName;
                document.getElementById('editLastName').value = data.lastName;
                document.getElementById('editEmail').value = data.email;
                document.getElementById('editSubject').value = data.subject;
                document.getElementById('editPosition').value = data.position;

                // Show the modal using Bootstrap
                const editModal = new bootstrap.Modal(document.getElementById('editaccountModal'));
                editModal.show();
            })
            .catch(error => {
                console.error('Error loading faculty data:', error);
                // Show error message to user
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to load faculty data. Please try again.'
                });
            });
        }

        // Add form submission handler for the edit form
        document.addEventListener('DOMContentLoaded', function() {
            const editForm = document.getElementById('editFacultyForm');

            if (editForm) {
                editForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = new FormData(editForm);
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    fetch("/AdminPortal/UpdateFaculty", {
                        method: "POST",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest",
                            "RequestVerificationToken": token
                        },
                        body: formData
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // Close the modal
                            const editModal = bootstrap.Modal.getInstance(document.getElementById('editaccountModal'));
                            if (editModal) editModal.hide();

                            // Show success message
                            Swal.fire({
                                icon: 'success',
                                title: 'Updated!',
                                text: data.message || 'Faculty information updated successfully',
                                showConfirmButton: true,
                                confirmButtonText: 'OK',
                                timer: 2000,
                                timerProgressBar: true,
                                willClose: () => {
                                    // Reload the page when the alert closes
                                    window.location.reload();
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to update faculty information'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Update error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred while updating faculty information.'
                        });
                    });
                });
            }
        });



    </script>

   
</body>

