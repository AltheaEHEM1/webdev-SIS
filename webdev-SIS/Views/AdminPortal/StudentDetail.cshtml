@model IEnumerable<StudentEntity>


@{
    Layout = "Admin_Layout";  // Specifies the layout to use
    ViewData["Title"] = "Student Detail";
}


<style>
    .container {
        background-color: #dce8fd;
        padding: 20px;
        border-radius: 10px;
    }
</style>

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <img src="~/images/bgjr.png" alt="Decorative background" class="img-fluid w-100"
         style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">

    <div style="background-color: rgba(220, 232, 253, 0.9); padding: 20px; border-radius: 10px;">
        <section class="d-flex justify-content-between align-items-center flex-wrap" style="font-weight: bold;">
            <p class="text-sm text-black fs-5">
                <i class="fas fa-user text-black"></i>
                <a asp-controller="AdminPortal" asp-action="Student" class="text-black" style="text-decoration: none;">Student Information</a>
            </p>

            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#unenrollModal">
                <i class="fas fa-user-minus ms-1"></i> Unenroll
            </button>
        </section>
        
        

        <div class="container">
            @if (Model != null && Model.Any())
            {
                @foreach (var studentsection in Model)
                {
                    <div class="container">
                        <div class="row">
                            <!-- Left Column -->
                            <div class="col-md-6">
                                <div class="card mb-4">
                                    <div class="card-header text-white fw-bold" style="background-color: #172154;">
                                        Incoming
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Grade Level:</strong></div>
                                            <div class="col-8">@studentsection.GradeLevel</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Section:</strong></div>
                                            <div class="col-8">@studentsection.SectionName</div>
                                        </div>

                                    </div>
                                </div>

                                @* Personal Information *@
                                <div class="card mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3" style="background-color: #172154;">
                                        <div class="card-header text-white fw-bold mb-0" style="padding-right: 15px;">
                                            Personal Information
                                        </div>
                                        <!-- Edit Link -->
                                        <a data-bs-toggle="modal" data-bs-target="#editPersonalInformationModal" style="color: #f1c40f; text-decoration: none; padding: 8px 16px;">
                                            Edit
                                        </a>
                                    </div>

                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Full Name:</strong></div>
                                            <div class="col-8">@($"{studentsection.FirstName} {studentsection.MiddleName} {studentsection.LastName} {studentsection.Suffix}")</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Email:</strong></div>
                                            <div class="col-8">@studentsection.Email</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Date of Birth:</strong></div>
                                            <div class="col-8">@studentsection.DateOfBirth.ToShortDateString()</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-4"><strong>Civil Status:</strong></div>
                                            <div class="col-md-8">@studentsection.CivilStatus</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Sex::</strong></div>
                                            <div class="col-md-8">@studentsection.Sex</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Country:</strong></div>
                                            <div class="col-md-8">@studentsection.Country</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Region:</strong></div>
                                            <div class="col-md-8">@studentsection.Region</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>City / Municipality:</strong></div>
                                            <div class="col-md-8">@studentsection.City</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Height:</strong>Height:</div>
                                            <div class="col-md-8">@studentsection.Height</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Weight:</strong></div>
                                            <div class="col-md-8">@studentsection.Weight</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Religion:</strong></div>
                                            <div class="col-md-8">@studentsection.Religion</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Disability:</strong></div>
                                            <div class="col-md-8">@studentsection.Disability</div>
                                        </div>
                                    </div>
                                </div>

                                @* Contact *@
                                <div class="card">
                                    <div class="d-flex justify-content-between align-items-center mb-3" style="background-color: #172154;">
                                        <div class="card-header text-white fw-bold mb-0" style="padding-right: 15px;">
                                            Contact
                                        </div>
                                        <!-- Edit Link -->
                                        <a data-bs-toggle="modal" data-bs-target="#editContactModal" style="color: #f1c40f; text-decoration: none; padding: 8px 16px;">
                                            Edit
                                        </a>
                                    </div>

                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Landline:</strong></div>
                                            <div class="col-md-8">@studentsection.Landline_number</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Phone:</strong></div>
                                            <div class="col-8">@studentsection.Phone_number</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-4 fw-bold">Emergency Contact:</div>
                                            <div class="col-md-8">@studentsection.ContactPerson - @studentsection.ContactNumber (@studentsection.Relationship)</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-4 fw-bold"> <strong>Emergency Landline:</strong></div>
                                            <div class="col-md-8">@studentsection.Emergency_landline_number</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Address *@
                            <!-- Right Column -->
                            <div class="col-md-6">
                                <div class="card mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3" style="background-color: #172154;">
                                        <div class="card-header text-white fw-bold mb-0" style="padding-right: 15px;">
                                            Address
                                        </div>
                                        <!-- Edit Link -->
                                        <a data-bs-toggle="modal" data-bs-target="#editAddressModal" style="color: #f1c40f; text-decoration: none; padding: 8px 16px;">
                                            Edit
                                        </a>
                                    </div>

                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Current:</strong></div>
                                            <div class="col-8">@($"{studentsection.HouseNo}, {studentsection.Street}, {studentsection.Barangay}, {studentsection.Municipality}, {studentsection.Province}, {studentsection.ZipCode}")</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Permanent:</strong></div>
                                            <div class="col-8">@($"{studentsection.PermanentHouseNo}, {studentsection.PermanentStreet}, {studentsection.PermanentBarangay}, {studentsection.PermanentMunicipality}, {studentsection.PermanentProvince}, {studentsection.PermanentZipCode}")</div>
                                        </div>
                                    </div>
                                </div>

                                @* Family *@
                                <div class="card mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3" style="background-color: #172154;">
                                        <div class="card-header text-white fw-bold mb-0" style="padding-right: 15px;">
                                            Family
                                        </div>
                                        <!-- Edit Link -->
                                        <a data-bs-toggle="modal" data-bs-target="#editFamilyModal" style="color: #f1c40f; text-decoration: none; padding: 8px 16px;">
                                            Edit
                                        </a>
                                    </div>

                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4"><strong>Parent:</strong></div>
                                            <div class="col-8">@($"{studentsection.ParentFirstName} {studentsection.ParentMiddleName} {studentsection.ParentLastName} - {studentsection.ParentContactNo} ({studentsection.ParentRelationship})")</div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4"><strong>Guardian:</strong></div>
                                            <div class="col-8">@($"{studentsection.GuardianFirstName} {studentsection.GuardianMiddleName} {studentsection.GuardianLastName} {studentsection.GuardianContactNo} ({studentsection.GuardianRelationship})")</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="d-flex justify-content-between align-items-center mb-3" style="background-color: #172154;">
                                        <div class="card-header text-white fw-bold mb-0" style="padding-right: 15px;">
                                            School
                                        </div>
                                        <!-- Edit Link -->
                                        <a data-bs-toggle="modal" data-bs-target="#editSchoolModal" style="color: #f1c40f; text-decoration: none; padding: 8px 16px;">
                                            Edit
                                        </a>
                                    </div>

                                    <div class="card-body p-3">
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Name:</div><div class="col-md-8">@studentsection.SchoolName</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Address:</div><div class="col-md-8">@studentsection.SchoolAddress</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Contact:</div><div class="col-md-8">@studentsection.SchoolContact</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">School Type:</div><div class="col-md-8">@studentsection.SchoolType</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">Year Of Graduation:</div><div class="col-md-8">@studentsection.YearOfGraduation</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">LRN:</div><div class="col-md-8">@studentsection.LRN</div></div>
                                        <div class="row mb-2"><div class="col-md-4 fw-bold">GWA:</div><div class="col-md-8">@studentsection.GWA</div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Unenroll Confirmation Modal -->
                    <div class="modal fade" id="unenrollModal" tabindex="-1" aria-labelledby="unenrollModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title" id="unenrollModalLabel">Confirm Unenrollment</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                <form id="unenrollForm" method="post" asp-controller="AdminPortal" asp-action="Unenroll">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-body">
                                        <p>Are you sure you want to unenroll this student?</p>

                                        <div class="mb-3">
                                            <label for="reasonDescription" class="form-label">Reason for Unenrollment</label>
                                            <textarea class="form-control" id="reasonDescription" name="ReasonDescription" rows="3" maxlength="300" required
                                                      placeholder="Please provide a brief reason (2-3 sentences)..."></textarea>
                                        </div>

                                        <!-- Hidden field for student Id -->
                                        <input type="hidden" name="id" id="unenrollStudentId" />
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button class="btn btn-outline-danger btn-sm" onclick="openUnenrollModal(@studentsection.Id)">
                                            <i class="fas fa-user-minus"></i> Unenroll
                                        </button>

                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>



                }
            }
            else
            {
                <p class="text-center text-muted">No admissions found.</p>
            }
        </div>
    </div>






    



    <!-- Edit Personal Information Modal -->
    <div class="modal fade" id="editPersonalInformationModal" tabindex="-1" aria-labelledby="editPersonalInformationLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="editPersonalInformationLabel">Edit Personal Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <form id="studentpersonalinfoForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Id" value="@(Model?.FirstOrDefault()?.Id ?? 0)" />

                       <div class="row mb-4">
                            <!-- First Name -->
                            <div class="col-md-3">
                                <label for="FirstName" class="form-label fw-bold">
                                    First Name
                                </label>
                                <input type="text" id="FirstName" name="FirstName" class="form-control"
                                       pattern="^[A-Za-z]+(?: [A-Za-z]+)*$"
                                       title="Only letters allowed. Spaces allowed for compound first names.">
                                <small class="text-danger" id="firstNameError"></small>
                            </div>

                            <!-- Middle Name -->
                            <div class="col-md-3">
                                <label for="MiddleName" class="form-label fw-bold">
                                    Middle Name
                                </label>
                                <input type="text" id="MiddleName" name="MiddleName" class="form-control"
                                       pattern="^[A-Za-z]+$"
                                       title="Only letters allowed.">
                                <small class="text-danger" id="middleNameError"></small>
                            </div>

                            <!-- last Name -->
                            <div class="col-md-3"> 
                                <label for="LastName" class="form-label fw-bold">
                                    Last Name
                                </label>
                                <input type="text" id="LastName" name="LastName" class="form-control"
                                       pattern="^[A-Za-z]+(?: [A-Za-z]+)*$"
                                       title="Only letters allowed. Spaces allowed for compound last names.">
                                <small class="text-danger" id="lastNameError"></small>
                            </div>

                            <!-- Suffix -->
                            <div class="col-md-3">
                                <label for="Suffix" class="form-label fw-bold">
                                    Suffix
                                </label>
                                <input type="text" id="Suffix" name="Suffix" class="form-control"
                                       pattern="^[A-Za-z/-]+$"
                                       title="Only letters, hyphens (-), and slashes (/) allowed.">
                                <small class="text-danger" id="SuffixError"></small>
                            </div>

                       </div>

                       <div class="row mb-4">
                            <!-- Email Address -->
                            <div class="col-md-3">
                                <label for="Email" class="form-label fw-bold">E-mail Address</label>
                                <input type="email" id="Email" name="Email" class="form-control form-input" title="Please enter a valid email address.">
                                <small id="emailError" class="error-message"></small>
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-3">
                                <label for="DateOfBirth" class="form-label fw-bold">Date of Birth</label>
                                <input type="date" id="DateOfBirth" name="DateOfBirth" class="form-control form-input"
                                       min="2012-01-01">
                                <small id="dobError" class="error-message"></small>
                            </div>

                            <!-- Civil Status -->
                            <div class="col-md-3">
                                <label for="CivilStatus" class="form-label fw-bold">Civil Status</label>
                                <input type="text" id="CivilStatus" name="CivilStatus" class="form-control">
                                <small id="civilStatusError" class="error-message"></small>
                            </div>

                            <!-- Sex -->
                            <div class="col-md-3">
                                <label for="sex" class="form-label fw-bold">Sex</label>
                                <select id="sex" name="Sex" class="form-select">
                                    <option value="">Select Sex</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                       </div>

                        <div class="row mb-4">                        
                            <!-- Country -->
                            <div class="col-md-4 mt-2">
                                <label for="Country" class="form-label fw-bold">Country</label>
                                <input type="text" id="Country" name="Country" class="form-control">
                                <small id="countryError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>

                            <!-- Region -->
                            <div class="col-md-4">
                                <label for="Region" class="form-label fw-bold">Region</label>
                                <input type="text" id="Region" name="Region" class="form-control">
                                <small id="regionError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>

                            <!-- City / Municipality -->
                            <div class="col-md-4">
                                <label for="City" class="form-label fw-bold">City / Municipality</label>
                                <input type="text" id="City" name="City" class="form-control">
                                <small id="cityError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>
                        </div>

                       <div class="row mb-4">
                            <!-- Height -->
                            <div class="col-md-3">
                                <label for="Height" class="form-label fw-bold">Height (cm)</label>
                                <input type="text" id="Height" name="Height" class="form-control form-input"
                                       title="Enter height in cm"
                                       oninput="restrictDecimalInput(this); validateHeight();">
                                <small id="heightError" class="error-message text-danger small"></small>
                            </div>

                            <!-- Weight -->
                            <div class="col-md-3">
                                <label for="Weight" class="form-label fw-bold">Weight (kg)</label>
                                <input type="text" id="Weight" name="Weight" class="form-control form-input"
                                       title="Enter weight in kg"
                                       oninput="restrictDecimalInput(this); validateWeight();">
                                <small id="weightError" class="error-message text-danger small"></small>
                            </div>

                            <!-- Religion -->
                            <div class="col-md-3">
                                <label for="Religion" class="form-label fw-bold">Religion</label>
                                <input type="text" id="Religion" name="Religion" class="form-control form-input">
                                <small id="religionError" class="error-message text-danger small"></small>
                            </div>

                            <!-- Disability -->
                            <div class="col-md-3">
                                <label for="Disability" class="form-label fw-bold">
                                    Disability (if any)
                                </label>
                                <input type="text" id="Disability" name="Disability" class="form-control form-input">
                                <small id="disabilityError" class="error-message text-danger small"></small>
                            </div>
                       </div>

 
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="savePersonalInfo()">Save</button>
                </div>
            </div>
        </div>
    </div>


    <!-- Edit Contact Modal -->
    <div class="modal fade" id="editContactModal" tabindex="-1" aria-labelledby="editContactModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="editContactModalLabel">Edit Contact</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form id="studentcontactform">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Id" value="@Model.FirstOrDefault()?.Id" />

                        <div class="row mb-4">
                            <!-- Landline Number -->
                            <div class="col-md-6">
                                <label for="LandlineNumber" class="form-label fw-bold">Landline Number</label>
                                <input type="tel" id="LandlineNumber" name="Landline_number"
                                       class="form-control form-input"
                                       inputmode="numeric" pattern="\d{8}" maxlength="8"
                                       title="Landline number must be exactly 8 digits."
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                       onchange="validateLandline('LandlineNumber', 'landlineError')">
                                <small id="landlineError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label for="Phone_number" class="form-label fw-bold">Phone Number</label>
                                <input type="tel" id="Phone_number" name="Phone_number"
                                       class="form-control form-input"
                                       inputmode="numeric" pattern="\d{11}" maxlength="11"
                                       title="Phone number must be exactly 11 digits."
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                <small id="phoneError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>
                        </div>

                        <div class="row mb-3 align-items-end">
                            <!-- Emergency Landline Number -->
                            <div class="form-group">
                                <label for="EmergencyLandlineNumber" class="form-label fw-bold">
                                    Emergency Landline Number
                                </label>
                                <input type="tel"
                                       id="EmergencyLandlineNumber"
                                       name="Emergency_landline_number"
                                       class="form-control form-input"
                                       inputmode="numeric"
                                       pattern="\d{8}" maxlength="8"
                                       title="Landline number must be exactly 8 digits."
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                       onchange="validateLandline('EmergencyLandlineNumber', 'emergencyLandlineError')">
                                <small id="emergencyLandlineError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>

                            <!-- Checkbox to Copy Landline -->
                            <div class="col-md-12 d-flex align-items-center mt-4">
                                <input type="checkbox" id="CopyLandline" class="form-check-input me-2" onchange="copyLandline()">
                                <label for="CopyLandline" class="form-check-label">Same as Emergency Landline</label>
                            </div>
                        </div>

                       <div class="row mb-4">
                            <!-- Contact Person -->
                            <div class="col-md-4">
                                <label for="ContactPerson" class="form-label fw-bold">Contact Person</label>
                                <input type="text" id="ContactPerson" name="ContactPerson" class="form-control form-input">
                                <small id="ContactPersonError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>

                            <!-- Contact Number -->
                            <div class="col-md-4">
                                <label for="ContactNumber" class="form-label fw-bold">Contact Number</label>
                                <input type="tel"
                                       id="ContactNumber"
                                       name="ContactNumber"
                                       class="form-control form-input"
                                       inputmode="numeric"
                                       pattern="\d{11}"
                                       maxlength="11"
                                       title="Only numbers allowed. Must be 11 digits."
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                <small id="ContactNumberError" class="error-message" style="font-size: 0.85em;"></small>
                            </div>

                            <!-- Relationship -->
                            <div class="col-md-3">
                                <label for="Relationship" class="form-label fw-bold">Relationship</label>
                                <input type="text" id="Relationship" name="Relationship" class="form-control form-input">
                                <small id="RelationshipError" class="error-message" style="font-size: 0.75em;"></small>
                            </div>
                       </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="saveContact()">Save</button>
                </div>
            </div>
        </div>
    </div>
   
    <!-- Edit Address Modal -->
    <div class="modal fade" id="editAddressModal" tabindex="-1" aria-labelledby="editAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="editAddressModalLabel">Edit Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form id="studentaddressForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Id" value="@Model.FirstOrDefault()?.Id" />

                        <!-- Current Address Section -->
                        <h5 class="fw-bold mb-3">Current Address</h5>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="HouseNo" class="form-label fw-bold">House/Building No.</label>
                                <input type="text"
                                       id="HouseNo"
