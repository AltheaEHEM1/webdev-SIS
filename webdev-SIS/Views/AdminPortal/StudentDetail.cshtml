    <script>
              function openUnenrollModal(studentId) {
            document.getElementById('unenrollStudentId').value = studentId;
            var unenrollModal = new bootstrap.Modal(document.getElementById('unenrollModal'));
            unenrollModal.show();
        }


          //restrcitions
            function restrictDecimalInput(el, maxDigitsBeforeDecimal = 3, maxDecimalPlaces = 2) {
                el.value = el.value
                    .replace(/[^0-9.]/g, '')                       // Only digits and dot
                    .replace(/(\..*)\./g, '$1')                    // Only one dot
                    .replace(new RegExp(`^(\\d{${maxDigitsBeforeDecimal}})\\d`), '$1'); // Max digits before decimal

                const parts = el.value.split(".");
                if (parts[1]?.length > maxDecimalPlaces) {
                    el.value = parts[0] + "." + parts[1].slice(0, maxDecimalPlaces);
                }
            }


            function limitTo11Digits(el) {
                el.value = el.value.replace(/\D/g, '').slice(0, 11); // Only digits, max 11
            }


            function validateGWAInput(el) {
                el.value = el.value
                    .replace(/[^0-9.]/g, '')           // Remove non-digits
                    .replace(/(\..*)\./g, '$1');       // Only one dot

                const parts = el.value.split(".");
                if (parts[1]?.length > 2) {
                    el.value = parts[0] + "." + parts[1].slice(0, 2);
                }

                const val = parseFloat(el.value);
                if (val > 100) el.value = "100.00";
            }



            document.addEventListener('DOMContentLoaded', function() {
                // Initialize modals with proper data
                initializeModals();

                // Add event listeners to the edit buttons
                document.querySelectorAll('[data-bs-toggle="modal"]').forEach(button => {
                    button.addEventListener('click', function() {
                        const modalId = this.getAttribute('data-bs-target').substring(1);
                        prepareModalData(modalId);
                    });
                });
            });


            // Initialize modals with Bootstrap
            function initializeModals() {
                // Make sure Bootstrap modals are properly initialized
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    new bootstrap.Modal(modal);
                });
            }

            // Prepare modal data before showing
            function prepareModalData(modalId) {
                const studentId = '@Model.FirstOrDefault()?.Id'; // Get student ID from the model

                switch(modalId) {
                    case 'editPersonalInformationModal':
                        populatePersonalInfoForm(studentId);
                        break;
                    case 'editContactModal':
                        populateContactForm(studentId);
                        break;
                    case 'editAddressModal':
                        populateAddressForm(studentId);
                        break;
                    case 'editFamilyModal':
                        populateFamilyForm(studentId);
                        break;
                    case 'editSchoolModal':
                        populateSchoolForm(studentId);
                        break;
                }
            }

            // Populate Personal Information form
            function populatePersonalInfoForm(studentId) {
                const student = getStudentData();

                // Set form values
                document.getElementById('FirstName').value = student.FirstName || '';
                document.getElementById('MiddleName').value = student.MiddleName || '';
                document.getElementById('LastName').value = student.LastName || '';
                document.getElementById('Suffix').value = student.Suffix || '';
                document.getElementById('Email').value = student.Email || '';

                // Format date properly for the date input (YYYY-MM-DD)
                if (student.DateOfBirth) {
                    const dob = new Date(student.DateOfBirth);
                    const formattedDate = dob.toISOString().split('T')[0];
                    document.getElementById('DateOfBirth').value = formattedDate;
                }

                document.getElementById('CivilStatus').value = student.CivilStatus || '';

                // Set select dropdown value
                const sexSelect = document.getElementById('sex');
                if (sexSelect) {
                    for (let i = 0; i < sexSelect.options.length; i++) {
                        if (sexSelect.options[i].value === student.Sex) {
                            sexSelect.selectedIndex = i;
                            break;
                        }
                    }
                }

                document.getElementById('Country').value = student.Country || '';
                document.getElementById('Region').value = student.Region || '';
                document.getElementById('City').value = student.City || '';
                document.getElementById('Height').value = student.Height || '';
                document.getElementById('Weight').value = student.Weight || '';
                document.getElementById('Religion').value = student.Religion || '';
                document.getElementById('Disability').value = student.Disability || '';
            }

            // Populate Contact form
            function populateContactForm(studentId) {
