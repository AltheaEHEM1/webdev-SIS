        // Function to copy address from current to permanent
        function copyAddress() {
            if (document.getElementById('sameAddress').checked) {
                document.getElementById('PermanentHouseNo').value = document.getElementById('HouseNo').value;
                document.getElementById('PermanentBarangay').value = document.getElementById('Barangay').value;
                document.getElementById('PermanentStreet').value = document.getElementById('Street').value;
                document.getElementById('PermanentMunicipality').value = document.getElementById('Municipality').value;
                document.getElementById('PermanentProvince').value = document.getElementById('Province').value;
                document.getElementById('PermanentZipCode').value = document.getElementById('ZipCode').value;
            } else {
                // Don't clear the fields when unchecked, just leave them as is
            }
        }

        // Function to copy landline
        function copyLandline() {
            if (document.getElementById('CopyLandline').checked) {
                document.getElementById('EmergencyLandlineNumber').value = document.getElementById('LandlineNumber').value;
            } else {
                // Don't clear the field when unchecked, just leave it as is
            }
