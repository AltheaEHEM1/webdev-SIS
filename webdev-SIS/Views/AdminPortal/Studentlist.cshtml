@model IEnumerable<StudentEntity>
@{
    Layout = "Admin_Layout"; // Specifies the layout to use
    ViewData["Title"] = "Student List"; // Ensure the title is descriptive
}

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <!-- Background Image -->
    <img src="~/images/bgjr.png"
         alt="Decorative background representing Grade 7"
         class="img-fluid w-100"
         style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">


    <!-- Main Content -->
    <div style="background-color: rgba(220, 232, 253, 0.9); padding: 20px; border-radius: 10px;">
        <section class="fixed ml-72 px-11 py-6 w-full top-20 left-0" style="font-weight: bold;">
            <div class="d-flex align-items-center">
                <div>
                    <i class="fas fa-home text-black fs-5"></i>
                    <a asp-controller="AdminPortal" asp-action="Student" class="text-black" style="text-decoration: none;">Student</a>
                    <span class="text-black"> / @ViewBag.GradeLevel / @ViewBag.SectionName</span>
                </div>
            </div>
        </section>

        <div class="table-responsive mt-3 d-flex justify-content-center">
            <table class="table">
                <thead>
                    <tr>
                        <th style="background-color: #162051; color: white; border-radius: 10px 0 0 0; text-align: center;">
                            LRN
                        </th>
                        <th style="background-color: #162051; color: white; text-align: center;">
                            Student Name
                        </th>
                        <th style="background-color: #162051; color: white; text-align: center;">
                            Gender
                        </th>
                        <th style="background-color: #162051; color: white; text-align: center;">
                            Date Enrolled
                        </th>
                        <th style="background-color: #162051; color: white; border-radius: 0 10px 0 0; text-align: center;">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var studentsection in Model)
                        {
                            <tr style="text-align: center;">
                                <td>@studentsection.LRN</td>
                                <td>@($"{studentsection.FirstName} {(string.IsNullOrWhiteSpace(studentsection.MiddleName) ? "" : studentsection.MiddleName + " ")}{studentsection.LastName}")</td>
                                <td>@studentsection.Sex</td>
                                <td>@studentsection.DateEnrolled.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <!-- View Button (Navigates to StudentDetail) -->
                                    <a asp-controller="AdminPortal" asp-action="StudentDetail" asp-route-id="@studentsection.Id" class="btn btn-primary btn-sm">
                                       View
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No enrolled students found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

   
</body>




