@* @model IEnumerable<StudentEntity> *@

@{
    Layout = "Admin_Layout"; 
    ViewData["Title"] = "Student"; 
}

<style>
    body {
        background-color: #f8f9fa; /* Light background */
    }

    .grade-card {
        border: 2px solid #dee2e6; /* Light gray border */
        padding: 15px;
        background-color: white; /* White card background */
        text-align: center;
    }

    /* Grade title background colors */
    .grade-title.grade-7 {
        background-color: #28a745;
    }
    /* Green */
    .grade-title.grade-8 {
        background-color: #ffc107;
    }
    /* Yellow */
    .grade-title.grade-9 {
        background-color: #dc3545;
    }
    /* Red */
    .grade-title.grade-10 {
        background-color: #007bff;
    }
    /* Blue */

    .grade-title {
        padding: 10px;
        color: white; /* White text for title */
        font-weight: bold;
        text-align: center;
    }

    .section-list {
        list-style-type: none; /* Remove bullet points */
        padding: 0;
    }

    /* Section item hover effect */
    .section-item {
        padding: 8px 0;
        border-top: 1px solid #dee2e6; /* Light gray line between section items */
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .section-item:hover {
            background-color: rgba(100, 149, 237, 0.1); /* Light blue background on hover */
            color: #0056b3; /* Blue text on hover */
            font-weight: bold;
        }

</style>

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <!-- Background Image -->
    <img src="~/images/bgjr.png" alt="Decorative background representing Grade 7" class="img-fluid w-100" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">

