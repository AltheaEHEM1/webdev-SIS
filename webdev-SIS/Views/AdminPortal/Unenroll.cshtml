@model IEnumerable<UnenrollEntity>

@{
    Layout = "Admin_Layout";
    ViewData["Title"] = "Unenrolled Students";
}

<body class="position-relative bg-image" style="font-family: 'Poppins', sans-serif; overflow-x: hidden; height: 100vh; width: 100vw; margin: 0;">
    <img src="~/images/bgjr.png"
         alt="Decorative background representing Grade 7"
         class="img-fluid w-100"
         style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">

    <div style="background-color: rgba(220, 232, 253, 0.9); padding: 20px; border-radius: 10px;">
        <section class="fixed ml-72 px-11 py-6 w-full top-20 left-0" style="font-weight: bold;">
            <p class="text-sm text-black fs-5 m-0 d-flex align-items-center">
                <i class="fas fa-user-check text-black me-2"></i>
                <a asp-controller="AdminPortal" asp-action="UnenrollList" class="text-black text-decoration-none fs-5">
                    Unenrolled Students
                </a>
            </p>
        </section>

        <div class="table-responsive mt-5 d-flex justify-content-center">
            <table class="table">
                <thead>
                    <tr>
                        <th style="background-color: #162051; color: white; border-radius: 10px 0 0 0; text-align: center;">LRN</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Student Name</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Grade Level</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Section</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Date Unenrolled</th>
                        <th style="background-color: #162051; color: white; text-align: center;">Reason</th>
                        <th style="background-color: #162051; color: white; border-radius: 0 10px 0 0; text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var Unenroll in Model)
                        {
                            <tr style="text-align: center;">
                                <td>@Unenroll.LRN</td>
                                <td>
                                    <a asp-action="UnenrollList" asp-controller="AdminPortal" asp-route-id="@Unenroll.Id" class="text-decoration-none text-dark">
                                        @($"{Unenroll.FirstName} {(string.IsNullOrWhiteSpace(Unenroll.MiddleName) ? "" : Unenroll.MiddleName + " ")}{Unenroll.LastName}")
                                    </a>
                                </td>
                                <td>@Unenroll.GradeLevel</td>
                                <td>@Unenroll.SectionName</td>
                                <td>@Unenroll.UnenrolledDate.ToString("MMMM dd, yyyy")</td>
                                <td>@Unenroll.ReasonDescription</td>
                                <td>
                                    <a asp-controller="AdminPortal" asp-action="UnenrollDetail" asp-route-id="@Unenroll.Id" class="btn btn-primary btn-sm">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No unenrolled students found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
