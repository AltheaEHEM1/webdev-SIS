<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Pre-fill Personal Information Modal
        document.querySelectorAll("[data-bs-target='#editPIModal']").forEach(button => {
            button.addEventListener("click", function () {
                let profileId = this.dataset.id; // Assuming each button has data-id with profile ID
                let profileName = this.dataset.name;
                let profileLastName = this.dataset.lastname;
                let profileEmail = this.dataset.email;
                let profilePhone = this.dataset.phone;

                document.getElementById("firstName").value = profileName;
                document.getElementById("lastName").value = profileLastName;
                document.getElementById("email").value = profileEmail;
                document.getElementById("phoneNo").value = profilePhone;
            });
        });

        // Handle Personal Info Form Submission via AJAX
        document.getElementById("editPIModal").querySelector("form").addEventListener("submit", async function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            try {
                const response = await fetch("/Profile/UpdatePersonalInfo", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Failed to update profile.");
                }

                const result = await response.json();
                if (result.success) {
                    showToast("Profile updated successfully!", "success");
                    bootstrap.Modal.getInstance(document.getElementById("editPIModal")).hide();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(result.message, "danger");
                }
            } catch (error) {
                console.error("Error updating profile:", error);
                showToast("Error updating profile.", "danger");
            }
        });

        // Pre-fill Address Modal
        document.querySelectorAll("[data-bs-target='#editAddressModal']").forEach(button => {
            button.addEventListener("click", function () {
                document.getElementById("houseNo").value = this.dataset.houseno;
                document.getElementById("streetName").value = this.dataset.street;
                document.getElementById("barangay").value = this.dataset.barangay;
                document.getElementById("city").value = this.dataset.city;
                document.getElementById("province").value = this.dataset.province;
                document.getElementById("zipCode").value = this.dataset.zip;
            });
        });

        // Handle Address Form Submission via AJAX
        document.getElementById("editAddressModal").querySelector("form").addEventListener("submit", async function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            try {
                const response = await fetch("/Profile/UpdateAddress", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Failed to update address.");
                }

                const result = await response.json();
                if (result.success) {
                    showToast("Address updated successfully!", "success");
                    bootstrap.Modal.getInstance(document.getElementById("editAddressModal")).hide();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(result.message, "danger");
                }
            } catch (error) {
                console.error("Error updating address:", error);
                showToast("Error updating address.", "danger");
            }
        });

        // Profile Picture Upload
        document.getElementById("uploadProfileModal").querySelector("form").addEventListener("submit", async function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            try {
                const response = await fetch("/Profile/UpdateProfilePicture", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Failed to upload profile picture.");
                }

                const result = await response.json();
                if (result.success) {
                    showToast("Profile picture updated successfully!", "success");
                    bootstrap.Modal.getInstance(document.getElementById("uploadProfileModal")).hide();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(result.message, "danger");
                }
            } catch (error) {
                console.error("Error uploading profile picture:", error);
                showToast("Error uploading profile picture.", "danger");
            }
        });

        // Toast function
        function showToast(message, type) {
            const toastContainer = document.createElement("div");
            toastContainer.className = `alert alert-${type} fixed-top m-3`;
            toastContainer.style.zIndex = "1050";
            toastContainer.innerHTML = message;

            document.body.appendChild(toastContainer);
            setTimeout(() => toastContainer.remove(), 3000);
        }
    });
</script>

