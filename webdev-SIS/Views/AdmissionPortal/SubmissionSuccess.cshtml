@model AdmissionEntity
@{
    Layout = "AdmissionLayout";  // Specifies the layout to use
    ViewData["Title"] = "SubmissionSuccess";
}

<div class="container mt-5">
    <!-- ✅ Show success notification -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2 class="fw-bold mb-4" style="color: #172154;">Application Submitted Successfully</h2>
    <p class="text-muted">Thank you for submitting your application. We will review your information and get back to you soon.</p>

</div>

